<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Além da Norma — Federal Invest</title>
<meta name="description" content="Inscrição para o evento Além da Norma, uma realização Kaluf & Gomes Soluções Empresariais.">
<meta property="og:title" content="Além da Norma — 20 de agosto, Anfiteatro da OAB Franca">
<meta property="og:description" content="Transforme a NR-1 de obrigação legal no maior motor de lucro da sua empresa. Vagas limitadas.">
<meta property="og:image" content="arte-evento.jpg">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,600;1,9..144,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --navy: #0A1F35;
    --navy-deep: #071626;
    --navy-panel: #12293F;
    --navy-panel-2: #16304A;
    --gold: #B8976A;
    --gold-soft: #D9C3A0;
    --white: #FFFFFF;
    --ink-soft: rgba(255,255,255,0.70);
    --ink-faint: rgba(255,255,255,0.45);
    --line: rgba(184,151,106,0.38);
    --error: #E2725B;
    --radius: 4px;
  }

  *{ box-sizing: border-box; }
  html{ scroll-behavior: smooth; }

  body{
    margin:0;
    background: var(--navy);
    color: var(--white);
    font-family: 'Inter', sans-serif;
    -webkit-font-smoothing: antialiased;
    line-height: 1.5;
  }

  .wrap{
    max-width: 720px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ---------- Header ---------- */
  header{
    padding: 32px 0 8px;
  }
  .brand{
    display:flex;
    align-items:center;
    gap:12px;
  }
  .brand svg, .brand img{ width:30px; height:30px; flex-shrink:0; display:block; }
  .partner-bar{
    width: 100%;
    background: #ffffff;
    padding: 26px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .partner-bar img{
    height: 64px;
    width: auto;
    display: block;
  }
  @media (max-width: 520px){
    .partner-bar img{ height: 48px; }
  }
  .brand-name{
    font-family:'Inter', sans-serif;
    font-size:12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  /* ---------- Hero ---------- */
  .hero{
    position:relative;
    overflow:hidden;
    padding: 64px 0 44px;
    text-align:center;
    opacity:0;
    transform: translateY(10px);
    animation: rise 0.8s ease-out 0.15s forwards;
  }
  .hero-bg{
    position:absolute;
    inset: -4%;
    background-image: url('data:image/jpeg;base64,');
    background-size: cover;
    background-position: center;
    z-index:0;
    animation: kenburns 26s ease-in-out infinite alternate;
  }
  .hero-bg::after{
    content:'';
    position:absolute;
    inset:0;
    background: radial-gradient(circle at 50% 38%, rgba(10,31,53,0.62) 0%, rgba(10,31,53,0.93) 72%, rgba(10,31,53,0.98) 100%);
  }
  @keyframes kenburns{
    from{ transform: scale(1); }
    to{ transform: scale(1.09); }
  }
  .hero > *{ position:relative; z-index:1; }
  @keyframes rise{
    to{ opacity:1; transform: translateY(0); }
  }

  .ruler{
    width:100%;
    max-width: 560px;
    margin: 0 auto;
    display:block;
  }
  .ruler line, .ruler .tick{
    stroke: var(--line);
    stroke-width: 1;
  }
  .ruler-draw{
    stroke-dasharray: 560;
    stroke-dashoffset: 560;
    animation: draw 1.1s ease-out 0.4s forwards;
  }
  @keyframes draw{ to{ stroke-dashoffset: 0; } }

  .eyebrow{
    margin: 22px 0 4px;
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-soft);
  }

  h1{
    font-family: 'Fraunces', serif;
    font-weight: 500;
    font-size: clamp(40px, 9vw, 68px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    margin: 6px 0 0;
    color: var(--white);
  }
  h1 em{
    font-style: italic;
    font-weight: 400;
    color: var(--gold);
  }

  .subhead{
    max-width: 480px;
    margin: 22px auto 0;
    font-size: 16px;
    color: var(--ink-soft);
  }

  .meta{
    margin-top: 26px;
    display:inline-flex;
    gap: 18px;
    flex-wrap:wrap;
    justify-content:center;
    font-size: 13px;
    color: var(--ink-faint);
    letter-spacing: 0.02em;
  }
  .meta span{ display:inline-flex; align-items:center; gap:7px; }
  .meta .dot{ width:4px; height:4px; border-radius:50%; background: var(--gold); display:inline-block; }

  /* ---------- About / speakers ---------- */
  .about{
    padding: 4px 0 24px;
    text-align:center;
    opacity:0;
    transform: translateY(10px);
    animation: rise 0.8s ease-out 0.3s forwards;
  }
  .about-lede{
    max-width: 480px;
    margin: 0 auto 32px;
    font-size: 15px;
    color: var(--ink-soft);
  }
  .bonus-badge{
    width: 118px;
    height: 118px;
    border-radius: 50%;
    background: rgba(184,151,106,0.10);
    border: 1px solid var(--line);
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    margin: 0 auto 44px;
  }
  .bonus-number{
    font-family:'Fraunces', serif;
    font-size: 32px;
    color: var(--gold);
    line-height:1;
  }
  .bonus-label{
    font-size: 10.5px;
    letter-spacing: 0.05em;
    color: var(--ink-soft);
    margin-top: 5px;
    line-height:1.3;
    text-align:center;
  }
  .speakers-title{
    font-family:'Fraunces', serif;
    font-weight: 500;
    font-size: 15px;
    color: var(--gold-soft);
    margin: 0 0 22px;
  }
  .speakers{
    list-style:none;
    padding:0;
    margin:0;
    display:grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px 26px;
    text-align:left;
  }
  .speakers li{
    display:flex;
    align-items:center;
    gap: 12px;
    border-top: 1px solid rgba(255,255,255,0.08);
    padding-top: 12px;
  }
  .speaker-photo{
    width: 50px;
    height: 50px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--line);
    flex-shrink: 0;
  }
  .speakers strong{
    display:block;
    font-size: 13.5px;
    font-weight:600;
    margin-bottom: 2px;
  }
  .speakers span{
    font-size: 12px;
    color: var(--ink-faint);
  }
  @media (max-width: 520px){
    .speakers{ grid-template-columns: 1fr; }
  }

  /* ---------- Form card ---------- */
  .card{
    background: var(--navy-panel);
    border: 1px solid rgba(184,151,106,0.18);
    border-radius: var(--radius);
    padding: 36px 28px;
    margin: 12px 0 64px;
    opacity:0;
    transform: translateY(10px);
    animation: rise 0.8s ease-out 0.5s forwards;
  }

  .card-title{
    font-family:'Fraunces', serif;
    font-size: 20px;
    font-weight: 500;
    margin: 0 0 4px;
  }
  .card-sub{
    font-size: 13.5px;
    color: var(--ink-faint);
    margin: 0 0 28px;
  }

  .field{ margin-bottom: 20px; }
  .row2{
    display:grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  @media (max-width: 520px){
    .row2{ grid-template-columns: 1fr; gap: 0; }
  }

  label{
    display:block;
    font-size: 12.5px;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    margin-bottom: 7px;
  }
  label .req{ color: var(--gold); }

  input[type="text"],
  input[type="email"],
  input[type="tel"]{
    width:100%;
    background: var(--navy-panel-2);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: var(--radius);
    color: var(--white);
    font-family:'Inter', sans-serif;
    font-size: 15px;
    padding: 12px 14px;
    outline: none;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  input::placeholder{ color: rgba(255,255,255,0.28); }
  input:focus-visible{
    border-color: var(--gold);
    background: #18334F;
  }
  input:focus{
    border-color: var(--gold);
  }
  input.invalid{ border-color: var(--error); }

  fieldset{
    border:none;
    padding:0;
    margin:0;
  }
  legend{
    font-size: 12.5px;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    margin-bottom: 10px;
    padding:0;
  }
  .toggle-group{
    display:flex;
    gap: 10px;
  }
  .toggle-option{
    flex:1;
    position:relative;
  }
  .toggle-option input{
    position:absolute;
    opacity:0;
    width:100%;
    height:100%;
    margin:0;
    cursor:pointer;
  }
  .toggle-option label{
    margin:0;
    text-align:center;
    padding: 12px 10px;
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: var(--radius);
    color: var(--ink-soft);
    font-size: 14.5px;
    cursor:pointer;
    transition: all 0.15s ease;
  }
  .toggle-option input:checked + label{
    border-color: var(--gold);
    background: rgba(184,151,106,0.14);
    color: var(--white);
  }
  .toggle-option input:focus-visible + label{
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  .error-msg{
    font-size: 12.5px;
    color: var(--error);
    margin-top: 6px;
    display:none;
  }
  .field.has-error .error-msg{ display:block; }

  .submit-row{ margin-top: 30px; }
  button[type="submit"]{
    width:100%;
    background: var(--gold);
    color: var(--navy-deep);
    border:none;
    border-radius: var(--radius);
    font-family:'Inter', sans-serif;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.02em;
    padding: 15px 20px;
    cursor:pointer;
    transition: background 0.15s ease, transform 0.1s ease;
  }
  button[type="submit"]:hover{ background: var(--gold-soft); }
  button[type="submit"]:focus-visible{
    outline: 2px solid var(--white);
    outline-offset: 2px;
  }
  button[type="submit"]:disabled{
    opacity: 0.6;
    cursor: default;
  }
  .cal-btn{
    display:block;
    margin-top: 16px;
    width:100%;
    background: transparent;
    color: var(--gold-soft);
    border: 1px solid rgba(184,151,106,0.35);
    border-radius: var(--radius);
    padding: 12px;
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    text-align: center;
    box-sizing: border-box;
    transition: background 0.15s ease;
  }
  .cal-btn:hover{ background: rgba(184,151,106,0.08); }

  .form-status{
    margin-top: 14px;
    font-size: 13px;
    text-align:center;
    color: var(--error);
    display:none;
  }
  .form-status.show{ display:block; }

  /* ---------- Success state ---------- */
  .success{
    display:none;
    text-align:center;
    padding: 20px 0 8px;
  }
  .success.show{ display:block; }
  .success svg{ width:40px; height:40px; margin-bottom: 18px; }
  .success h2{
    font-family:'Fraunces', serif;
    font-weight:500;
    font-size: 26px;
    margin: 0 0 10px;
  }
  .success p{
    color: var(--ink-soft);
    font-size: 14.5px;
    max-width: 360px;
    margin: 0 auto;
  }

  footer{
    padding: 28px 0 40px;
    text-align:center;
    color: var(--ink-faint);
  }
  footer .brand-line{
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  footer p{ margin: 0 0 8px; font-size: 12px; }
  footer a{ color: var(--gold-soft); text-decoration:none; }
  footer a:hover{ text-decoration:underline; }

  @media (prefers-reduced-motion: reduce){
    .hero, .about, .card{ animation: none; opacity:1; transform:none; }
    .ruler-draw{ animation:none; stroke-dashoffset:0; }
    .hero-bg{ animation:none; }
  }
</style>
</head>
<body>

<div class="partner-bar">
  <img src="data:image/png;base64," alt="Federal Invest">
</div>

<div class="wrap">

  

  <section class="hero">
    <div class="hero-bg"></div>
    <svg class="ruler" viewBox="0 0 560 20" aria-hidden="true">
      <line class="ruler-draw" x1="0" y1="10" x2="560" y2="10"/>
      <line class="tick" x1="0" y1="4" x2="0" y2="16"/>
      <line class="tick" x1="140" y1="6" x2="140" y2="14"/>
      <line class="tick" x1="280" y1="4" x2="280" y2="16"/>
      <line class="tick" x1="420" y1="6" x2="420" y2="14"/>
      <line class="tick" x1="560" y1="4" x2="560" y2="16"/>
    </svg>

    <p class="eyebrow">Um evento Kaluf &amp; Gomes</p>
    <h1>Além <em>da</em> Norma</h1>
    <p class="subhead">Transforme a NR-1 de obrigação legal no maior motor de lucro da sua empresa — um encontro para quem decide sobre pessoas.</p>

    <p class="meta">
      <span><span class="dot"></span>20 de agosto · 7h30</span>
      <span><span class="dot"></span>Anfiteatro da OAB – Subseção Franca</span>
      <span><span class="dot"></span>Vagas limitadas</span>
    </p>
  </section>

  <section class="about">
    <p class="about-lede">Você ainda enxerga a NR-1 como só mais uma obrigação burocrática? Está na hora de mudar essa visão: a aplicação estratégica da norma pode transformar a cultura da sua empresa, proteger sua equipe e virar o maior motor de lucro do negócio.</p>

    <div class="bonus-badge">
      <span class="bonus-number">25</span>
      <span class="bonus-label">diagnósticos<br>gratuitos</span>
    </div>

    <p class="speakers-title">Quem vai estar com você nessa manhã</p>
    <ul class="speakers">
      <li>
        <img class="speaker-photo" src="data:image/jpeg;base64," alt="Telma Rodrigues">
        <div><strong>Telma Rodrigues</strong><span>Consultora de Governança e Conselheira de Remuneração</span></div>
      </li>
      <li>
        <img class="speaker-photo" src="data:image/jpeg;base64," alt="Cristiane Olegário">
        <div><strong>Cristiane Olegário</strong><span>Doutora em Serviço Social, especialista em ESG</span></div>
      </li>
      <li>
        <img class="speaker-photo" src="data:image/jpeg;base64," alt="Dr. Luiz Lago">
        <div><strong>Dr. Luiz Lago</strong><span>Advogado Trabalhista</span></div>
      </li>
      <li>
        <img class="speaker-photo" src="data:image/jpeg;base64," alt="Rafael Garcia">
        <div><strong>Rafael Garcia</strong><span>Produto, Metodologia e Evolução da NR-1</span></div>
      </li>
      <li>
        <img class="speaker-photo" src="data:image/jpeg;base64," alt="Fábio Alexandre Moreira">
        <div><strong>Fábio Alexandre Moreira</strong><span>Implementação, Compliance e Governança da NR-1</span></div>
      </li>
      <li>
        <img class="speaker-photo" src="data:image/jpeg;base64," alt="Raquel Fanan">
        <div><strong>Raquel Fanan</strong><span>Consultora de Cultura Organizacional</span></div>
      </li>
    </ul>
  </section>

  <section class="card" id="form-card">

    <div id="form-view">
      <p class="card-title">Garanta sua vaga</p>
      <p class="card-sub">Preencha os dados abaixo para confirmar sua inscrição.</p>

      <form id="inscricaoForm" novalidate>

        <div class="field" id="field-nome">
          <label for="nome">Nome completo <span class="req">*</span></label>
          <input type="text" id="nome" name="nome" autocomplete="name" placeholder="Seu nome completo">
          <p class="error-msg">Informe seu nome completo.</p>
        </div>

        <div class="row2">
          <div class="field" id="field-empresa">
            <label for="empresa">Empresa <span class="req">*</span></label>
            <input type="text" id="empresa" name="empresa" autocomplete="organization" placeholder="Nome da empresa">
            <p class="error-msg">Informe a empresa.</p>
          </div>
          <div class="field" id="field-cargo">
            <label for="cargo">Cargo <span class="req">*</span></label>
            <input type="text" id="cargo" name="cargo" autocomplete="organization-title" placeholder="Seu cargo">
            <p class="error-msg">Informe o cargo.</p>
          </div>
        </div>

        <div class="field" id="field-telefone">
          <label for="telefone">Telefone / WhatsApp <span class="req">*</span></label>
          <input type="tel" id="telefone" name="telefone" inputmode="numeric" autocomplete="tel" placeholder="(00) 00000-0000">
          <p class="error-msg">Informe um telefone válido com DDD.</p>
        </div>

        <div class="field" id="field-email">
          <label for="email">E-mail <span class="req">*</span></label>
          <input type="email" id="email" name="email" autocomplete="email" placeholder="voce@empresa.com.br">
          <p class="error-msg">Informe um e-mail válido.</p>
        </div>

        <div class="field" id="field-rh">
          <fieldset>
            <legend>Você é responsável pelas decisões de RH ou gestão de pessoas na empresa? <span class="req">*</span></legend>
            <div class="toggle-group">
              <div class="toggle-option">
                <input type="radio" id="rh-sim" name="responsavelRH" value="Sim">
                <label for="rh-sim">Sim</label>
              </div>
              <div class="toggle-option">
                <input type="radio" id="rh-nao" name="responsavelRH" value="Não">
                <label for="rh-nao">Não</label>
              </div>
            </div>
          </fieldset>
          <p class="error-msg">Selecione uma opção.</p>
        </div>

        <div class="field" id="field-resp-contato" style="display:none;">
          <label for="respContato">Contato do responsável (nome e cargo) <span class="req">*</span></label>
          <input type="text" id="respContato" name="respContato" placeholder="Ex.: Maria Silva, Gerente de RH">
          <p class="error-msg">Informe nome e cargo do responsável pela área.</p>
        </div>

        <div class="submit-row">
          <button type="submit" id="submitBtn">Garantir minha vaga</button>
          <p class="form-status" id="formStatus"></p>
        </div>

      </form>
    </div>

    <div class="success" id="success-view">
      <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="20" cy="20" r="19" stroke="#B8976A" stroke-width="1.6"/>
        <path d="M12 20.5L17 25.5L28 14" stroke="#B8976A" stroke-width="2"/>
      </svg>
      <h2>Inscrição confirmada</h2>
      <p>Seu QR Code de entrada está abaixo e também será enviado por e-mail junto com a arte do evento.</p>
      <canvas id="qrCanvas" style="display:none;"></canvas>
      <img id="qrImage" alt="QR Code de acesso ao evento" width="180" height="180" style="margin: 18px auto 6px; display:block; border-radius:4px;">
      <p style="font-size:12px;color:var(--ink-faint);">Apresente este código na entrada do Além da Norma.</p>
      <a id="calBtn" class="cal-btn" href="#" target="_blank" rel="noopener">+ Adicionar à Google Agenda</a>
    </div>

  </section>

  <footer>
    <p class="brand-line">Kaluf &amp; Gomes Soluções Empresariais · Franca / Patrocínio Paulista, SP</p>
    <p>Apoio: OAB São Paulo – Subseção Franca</p>
    <p>Patrocínio: Propagare.IA · Travessia · MarkUP · Lago | Lima Advogados</p>
    <p>Já se inscreveu? <a href="meu-qrcode.html">Recupere seu QR Code aqui</a></p>
    <p>Dúvidas? WhatsApp <a href="https://wa.me/5516993030504" target="_blank" rel="noopener">(16) 99303-0504</a></p>
  </footer>

</div>

<!-- Firebase -->
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
<script>
  // ⚠️ Substitua pelos dados do SEU projeto Firebase (Configurações do projeto > Seus apps > SDK setup).
  const firebaseConfig = {
    apiKey: "AIzaSyAXA_fBPUJ_e_wT9n6Vi0frxBTHTtrxvkY",
    authDomain: "cadastro-94a4b.firebaseapp.com",
    databaseURL: "https://cadastro-94a4b-default-rtdb.firebaseio.com",
    projectId: "cadastro-94a4b",
    storageBucket: "cadastro-94a4b.firebasestorage.app",
    messagingSenderId: "796888459098",
    appId: "1:796888459098:web:09add119f89b7b66bf7563",
    measurementId: "G-X60Y1K88JX"
  };

  firebase.initializeApp(firebaseConfig);
  const db = firebase.database();

  // ⚠️ Dados do EmailJS (emailjs.com → Account → General, e seu Service/Template).
  const EMAILJS_PUBLIC_KEY = 'VbuF0HRWclBD8edWs';
  const EMAILJS_SERVICE_ID = 'service_9lhf5uw';
  const EMAILJS_TEMPLATE_ID = 'tmy93g9';
  emailjs.init({ publicKey: EMAILJS_PUBLIC_KEY });

  const form = document.getElementById('inscricaoForm');
  const submitBtn = document.getElementById('submitBtn');
  const formStatus = document.getElementById('formStatus');

  function phoneMask(value){
    value = value.replace(/\D/g, '').slice(0, 11);
    if (value.length > 10){
      return value.replace(/(\d{2})(\d{5})(\d{0,4})/, '($1) $2-$3').trim().replace(/-$/, '');
    } else if (value.length > 6){
      return value.replace(/(\d{2})(\d{4})(\d{0,4})/, '($1) $2-$3').trim().replace(/-$/, '');
    } else if (value.length > 2){
      return value.replace(/(\d{2})(\d{0,5})/, '($1) $2').trim();
    } else if (value.length > 0){
      return value.replace(/(\d{0,2})/, '($1');
    }
    return value;
  }

  document.getElementById('telefone').addEventListener('input', (e) => {
    e.target.value = phoneMask(e.target.value);
  });

  function setError(fieldId, hasError){
    const field = document.getElementById(fieldId);
    field.classList.toggle('has-error', hasError);
  }

  function isValidEmail(v){
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
  }
  function isValidPhone(v){
    return v.replace(/\D/g, '').length >= 10;
  }

  const respContatoField = document.getElementById('field-resp-contato');
  const respContatoInput = document.getElementById('respContato');

  function toggleRespContato(){
    const naoSelecionado = document.getElementById('rh-nao').checked;
    respContatoField.style.display = naoSelecionado ? 'block' : 'none';
    if (!naoSelecionado){
      respContatoField.classList.remove('has-error');
    }
  }
  document.querySelectorAll('input[name="responsavelRH"]').forEach(function(radio){
    radio.addEventListener('change', toggleRespContato);
  });

  form.addEventListener('submit', function(e){
    e.preventDefault();
    formStatus.classList.remove('show');

    const nome = document.getElementById('nome').value.trim();
    const empresa = document.getElementById('empresa').value.trim();
    const cargo = document.getElementById('cargo').value.trim();
    const telefone = document.getElementById('telefone').value.trim();
    const email = document.getElementById('email').value.trim();
    const rhSelecionado = form.querySelector('input[name="responsavelRH"]:checked');

    let valid = true;
    setError('field-nome', nome.length < 3);
    if (nome.length < 3) valid = false;

    setError('field-empresa', empresa.length < 2);
    if (empresa.length < 2) valid = false;

    setError('field-cargo', cargo.length < 2);
    if (cargo.length < 2) valid = false;

    setError('field-telefone', !isValidPhone(telefone));
    if (!isValidPhone(telefone)) valid = false;

    setError('field-email', !isValidEmail(email));
    if (!isValidEmail(email)) valid = false;

    setError('field-rh', !rhSelecionado);
    if (!rhSelecionado) valid = false;

    const precisaContatoResp = rhSelecionado && rhSelecionado.value === 'Não';
    const respContato = respContatoInput.value.trim();
    if (precisaContatoResp){
      setError('field-resp-contato', respContato.length < 3);
      if (respContato.length < 3) valid = false;
    } else {
      setError('field-resp-contato', false);
    }

    if (!valid){
      formStatus.textContent = 'Confira os campos destacados acima.';
      formStatus.classList.add('show');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando...';

    const registro = {
      nomeCompleto: nome,
      empresa: empresa,
      cargo: cargo,
      telefone: telefone,
      email: email,
      responsavelRH: rhSelecionado.value,
      criadoEm: firebase.database.ServerValue.TIMESTAMP,
      origem: 'site-inscricao',
      checkin: false,
      checkinTimestamp: null
    };
    if (precisaContatoResp) registro.contatoResponsavel = respContato;

    const novaInscricaoRef = db.ref('inscricoesAlemDaNorma').push();

    novaInscricaoRef.set(registro).then(function(){
      document.getElementById('form-view').style.display = 'none';
      document.getElementById('success-view').classList.add('show');

      const base = window.location.href.replace(/index\.html.*$/, '').replace(/\/?$/, '/');
      const checkinUrl = base + 'checkin.html?id=' + novaInscricaoRef.key;
      const qrImageUrl = 'https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=' + encodeURIComponent(checkinUrl);
      const artImageUrl = base + 'arte-evento.jpg';

      document.getElementById('qrImage').src = qrImageUrl;

      // 20/08/2026, 7h30 às 11h, horário de Brasília
      const calendarUrl = 'https://calendar.google.com/calendar/render?action=TEMPLATE'
        + '&text=' + encodeURIComponent('Além da Norma')
        + '&dates=20260820T073000/20260820T110000'
        + '&ctz=' + encodeURIComponent('America/Sao_Paulo')
        + '&details=' + encodeURIComponent('Evento Kaluf & Gomes sobre NR-1, cultura organizacional e gestão de pessoas. Café no local. Apresente o QR Code de inscrição na entrada.')
        + '&location=' + encodeURIComponent('Anfiteatro da OAB – Subseção Franca, Franca - SP');

      document.getElementById('calBtn').href = calendarUrl;

      emailjs.send(EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, {
        to_email: email,
        to_name: nome,
        empresa: empresa,
        cargo: cargo,
        qr_image_url: qrImageUrl,
        art_image_url: artImageUrl,
        checkin_url: checkinUrl,
        calendar_url: calendarUrl
      }).catch(function(emailErr){
        // não bloqueia a inscrição (já salva no Firebase) se o e-mail falhar
        console.error('Falha ao enviar e-mail de confirmação:', emailErr);
        alert('ERRO AO ENVIAR E-MAIL (temporário, para diagnóstico): ' + JSON.stringify(emailErr));
      });
    }).catch(function(err){
      console.error(err);
      formStatus.textContent = 'Não foi possível enviar. Tente novamente em instantes.';
      formStatus.classList.add('show');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Garantir minha vaga';
    });
  });
</script>

</body>
</html>
